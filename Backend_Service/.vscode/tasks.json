{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build OrderAPI",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/OrderAPI/OrderAPI.csproj",
                "--configuration",
                "Debug"
            ],
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "build AuthService",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/AuthService/AuthService.csproj",
                "--configuration",
                "Debug"
            ],
            "problemMatcher": "$msCompile",
            "group": "build"
        }
    ]
}
